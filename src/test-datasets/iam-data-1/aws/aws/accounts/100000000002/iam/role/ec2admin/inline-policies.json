[
  {
    "PolicyName": "ec2admin",
    "PolicyDocument": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "AllEc2",
          "Effect": "Allow",
          "Action": ["ec2:*"],
          "Resource": "*"
        },
        {
          "Sid": "BedrockAllowedByIdentity",
          "Effect": "Allow",
          "Action": "bedrock:GetFoundationModel",
          "Resource": "arn:aws:bedrock:us-east-1::foundation-model/example.model-v1:0"
        }
      ]
    }
  }
]
