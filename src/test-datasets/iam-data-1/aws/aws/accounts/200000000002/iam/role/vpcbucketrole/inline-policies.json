[
  {
    "PolicyName": "ListBucket",
    "PolicyDocument": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": ["s3:ListBucket"],
          "Resource": ["arn:aws:s3:::vpc-bucket"],
          "Condition": {
            "StringEquals": {
              "aws:SourceVpc": "vpc-123456789"
            }
          }
        },
        {
          "Effect": "Allow",
          "Action": ["s3:ListBucket"],
          "Resource": ["arn:aws:s3:::context-key-bucket"],
          "Condition": {
            "StringEquals": {
              "s3:authType": "REST-HEADER"
            }
          }
        },
        {
          "Effect": "Allow",
          "Action": ["s3:ListBucket"],
          "Resource": ["arn:aws:s3:::context-key-bucket"],
          "Condition": {
            "NumericGreaterThanEquals": {
              "s3:TlsVersion": "1.2"
            }
          }
        },
        {
          "Effect": "Allow",
          "Action": ["s3:ListBucket"],
          "Resource": ["arn:aws:s3:::context-key-present-bucket"],
          "Condition": {
            "Null": {
              "s3:authType": "false"
            }
          }
        },
        {
          "Effect": "Allow",
          "Action": ["s3:ListBucket"],
          "Resource": ["arn:aws:s3:::context-key-absent-bucket"],
          "Condition": {
            "Null": {
              "s3:TlsVersion": "true"
            }
          }
        }
      ]
    }
  }
]
