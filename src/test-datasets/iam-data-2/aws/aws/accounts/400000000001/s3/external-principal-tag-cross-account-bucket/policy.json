{
  "Version": "2012-10-17",
  "Statement": {
    "Sid": "AllowSecurityTeam",
    "Effect": "Allow",
    "Principal": "*",
    "Action": "s3:GetObject",
    "Resource": "arn:aws:s3:::external-principal-tag-cross-account-bucket/*",
    "Condition": {
      "StringEquals": {
        "aws:PrincipalTag/team": "security"
      }
    }
  }
}
