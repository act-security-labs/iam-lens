[
  {
    "PolicyDocument": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "ec2:TerminateInstances",
          "Resource": "*",
          "Condition": {
            "StringEquals": {
              "ec2:ResourceTag/env": "dev"
            }
          }
        },
        {
          "Effect": "Allow",
          "Action": ["secretsmanager:DescribeSecret", "ssm:GetParameter"],
          "Resource": "*"
        },
        {
          "Effect": "Allow",
          "Action": "lambda:GetProvisionedConcurrencyConfig",
          "Resource": "arn:aws:lambda:us-east-1:400000000002:function:tag-test-*:*",
          "Condition": { "StringEquals": { "aws:ResourceTag/Owner": "team" } }
        }
      ]
    },
    "PolicyName": "Operator"
  }
]
