{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAll",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::oai-canonical-bucket/*"
    },
    {
      "Sid": "DenyCanonical",
      "Effect": "Deny",
      "Principal": {
        "CanonicalUser": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::oai-canonical-bucket/*"
    }
  ]
}
