{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCollectedAndMissingOais",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::cloudfront:user/CloudFront Origin Access Identity E123EXAMPLE",
          "arn:aws:iam::cloudfront:user/CloudFront Origin Access Identity E789MISSING"
        ]
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::oai-unresolved-bucket/*"
    }
  ]
}
