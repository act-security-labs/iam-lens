{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::600000000001:root" },
      "Action": "sts:AssumeRole"
    },
    {
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::600000000001:root" },
      "Action": "sts:TagSession",
      "Condition": {
        "ForAllValues:StringEquals": { "aws:TagKeys": "Environment" }
      }
    }
  ]
}
