{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["kms:Decrypt", "kms:RetireGrant"],
      "Resource": [
        "arn:aws:kms:us-east-1:400000000002:key/test-key-aws-managed",
        "arn:aws:kms:us-east-1:400000000002:key/test-key-retire-grant"
      ]
    },
    {
      "Effect": "Deny",
      "Principal": "*",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::400000000002:role/aws-service-role/example.amazonaws.com/AWSServiceRoleForExample"
    }
  ]
}
