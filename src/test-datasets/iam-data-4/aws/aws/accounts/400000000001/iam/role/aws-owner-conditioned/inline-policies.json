[
  {
    "PolicyName": "SameAccountBucketListing",
    "PolicyDocument": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "s3:ListBucket",
          "Resource": "*",
          "Condition": {
            "StringEquals": { "aws:ResourceAccount": "400000000001" }
          }
        }
      ]
    }
  }
]
