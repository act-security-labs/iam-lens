[
  {
    "PolicyDocument": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "ec2:TerminateInstances",
          "Resource": "*",
          "Condition": {
            "StringEquals": {
              "aws:ResourceTag/env": "dev"
            }
          }
        },
        {
          "Effect": "Allow",
          "Action": ["secretsmanager:DescribeSecret", "ssm:GetParameter"],
          "Resource": "*"
        }
      ]
    },
    "PolicyName": "Operator"
  }
]
